# =====================================================
# Parasmani Skills Frontend — Environment Template
# Copy to frontend/.env.local and fill in real values.
# Never commit frontend/.env.local (already in .gitignore).
#
# IMPORTANT: Anything prefixed with NEXT_PUBLIC_ is bundled
# into the client JS and is visible to end users. Do not
# put secrets here.
# =====================================================

# Public URL of the backend HTTP API (used by axios for /api/*).
# Must EXACTLY match the public origin of the deployed backend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of the backend Socket.io endpoint.
# Same origin as NEXT_PUBLIC_API_URL in almost every deployment.
# (Socket.io upgrades /socket.io/ on this origin to a websocket.)
NEXT_PUBLIC_WS_URL=http://localhost:4000
